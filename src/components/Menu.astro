---
import menu from '../../data/menu.json';
import {copy, categories, routes, type Lang} from '../site';
const {lang}=Astro.props as {lang:Lang}; const ro=lang==='ro'; const t=copy[lang];
---
<section class="container page-intro menu-intro"><p class="eyebrow">{ro?'BUCĂTĂRIA NOASTRĂ, PE ÎNDELETE':'OUR KITCHEN, AT YOUR LEISURE'}</p><div class="title-row"><h1>{ro?'La masă,':'At the table,'}<br/><em>{ro?'la Erra.':'at Erra.'}</em></h1><p class="lead">{ro?'Din cuptor, din grădină, din suflet. Alege ceva pe gustul tău.':'From the oven, from the garden, from the heart. Find something you love.'}</p></div><p class="notice">{t.menuCaveat}</p></section>
<div class="menu-toolbar"><div class="container toolbar-inner"><nav aria-label={ro?'Categorii meniu':'Menu categories'} class="category-nav">{categories.map(cat=><a href={`#${cat.id}`}>{ro?cat.short_ro:cat.short_en}</a>)}</nav><div class="menu-search"><label class="sr-only" for="dish-search">{ro?'Caută în meniu':'Search menu'}</label><span aria-hidden="true">⌕</span><input type="search" id="dish-search" placeholder={ro?'Caută un preparat…':'Find a dish…'} autocomplete="off" /></div></div></div>
<div class="container menu-content"><p class="search-status sr-only" id="search-status" role="status" data-ro={ro?'preparate găsite':'dishes found'}></p><p id="no-results" class="no-results" hidden>{ro?'Niciun preparat găsit. Încearcă alt cuvânt sau șterge căutarea.':'No dishes found. Try another word or clear your search.'}</p>
{categories.map((cat,idx)=><section class="menu-category" id={cat.id} data-category><div class="category-heading"><div><p class="eyebrow">0{idx+1} / {ro?'DIN MENIU':'ON THE MENU'}</p><h2>{ro?cat.ro:cat.en}</h2><p>{ro?cat.note_ro:cat.note_en}</p></div><span class="category-count" aria-label={`${menu.filter(i=>i.category===cat.id).length} ${ro?'preparate':'dishes'}`}>{String(menu.filter(i=>i.category===cat.id).length).padStart(2,'0')}</span></div><div class="menu-grid">{menu.filter(item=>item.category===cat.id).map(item=><article class="menu-item" data-dish data-search={`${item.name_ro} ${item.name_en} ${item.description_ro} ${item.description_en}`}><div class="menu-item-heading"><h3>{ro?item.name_ro:item.name_en}</h3><span class:list={['price',{'price-unknown':item.price===null}]}>{item.price===null?t.ask:`${item.price} lei`}</span></div>{(ro?item.description_ro:item.description_en)&&<p>{ro?item.description_ro:item.description_en}</p>}</article>)}</div></section>)}
<div class="dietary-note"><span aria-hidden="true">✳</span><p>{t.dietary}</p><a class="text-link" href={routes[lang].contact}>{ro?'Vorbește cu noi':'Talk to us'} ↗</a></div>
</div>
<script>
const search=document.querySelector<HTMLInputElement>('#dish-search');
const normalise=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase().trim();
search?.addEventListener('input',()=>{
 const query=normalise(search.value); let count=0;
 document.querySelectorAll<HTMLElement>('[data-dish]').forEach(item=>{item.hidden=!normalise(item.dataset.search||'').includes(query); if(!item.hidden)count++;});
 document.querySelectorAll<HTMLElement>('[data-category]').forEach(cat=>{cat.hidden=!cat.querySelector('[data-dish]:not([hidden])');});
 const empty=document.querySelector<HTMLElement>('#no-results'); if(empty)empty.hidden=count>0;
 const status=document.querySelector('#search-status'); if(status)status.textContent=`${count} ${status.getAttribute('data-ro')}`;
});
</script>
