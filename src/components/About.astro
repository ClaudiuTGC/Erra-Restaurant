---
import Arrow from './Arrow.astro';
import { copy, routes, type Lang } from '../site';
const { lang } = Astro.props as { lang: Lang };
const ro = lang === 'ro';
---

<section class="container page-intro">
  <p class="eyebrow">{ro ? 'POVESTEA NOASTRĂ' : 'OUR STORY'}</p>
  <h1>
    {ro ? 'Bucuria lucrurilor' : 'The joy of things'}
    <br />
    <em>{ro ? 'făcute cu gust.' : 'made with care.'}</em>
  </h1>
</section>
<section class="container about-grid">
  <div class="about-art">
    <img
      src="/images/table.svg"
      width="660"
      height="760"
      alt={
        ro
          ? 'Ilustrație a unei mese pregătite cu o ramură de măslin; fotografie de restaurant în așteptare.'
          : 'Illustration of a table set with an olive branch; restaurant photography to come.'
      }
    />
    <p class="image-caption">
      {ro ? 'O invitație ilustrată la masa noastră.' : 'An illustrated invitation to our table.'}
    </p>
  </div>
  <div class="about-story">
    <p class="eyebrow">ERRA RESTAURANT · BUCUREȘTI</p>
    <h2>
      {ro ? 'O masă bună începe' : 'A good meal starts'}
      <br />
      <em>{ro ? 'cu oameni.' : 'with people.'}</em>
    </h2>
    <p class="lead">
      {ro
        ? 'Erra aduce împreună gusturile bucătăriei italienești și libertatea unui bistro modern. Un loc pentru întâlniri, conversații și mese fără grabă.'
        : 'Erra brings together the flavours of Italian cooking and the freedom of a modern bistro. A place for getting together, conversation, and meals without a rush.'}
    </p>
    <p>
      {ro
        ? 'Meniul semnat de Chef Alex Teisanu pune la aceeași masă pizza din cuptor pe lemne, focaccia, paste și preparate de bistro. Dincolo de preparate, ideea e simplă: să te simți bine la masă.'
        : 'The menu by Chef Alex Teisanu brings wood-fired pizza, focaccia, pasta and bistro dishes to the same table. Beyond the food, the idea is simple: to feel at home at the table.'}
    </p>
    <div class="chef-signature">
      <span>Alex Teisanu</span>
      <small>CHEF · ERRA RESTAURANT</small>
    </div>
    <a class="text-link" href={routes[lang].menu}>
      {copy[lang].fullMenu} <Arrow />
    </a>
  </div>
</section>
<section class="quote-section">
  <div class="container">
    <p class="eyebrow">{ro ? 'LA NOI, LA MASĂ' : 'AT OUR TABLE'}</p>
    <h2>
      {ro ? 'Mai puțină grabă.' : 'A little less hurry.'}
      <br />
      <em>{ro ? 'Mai mult gust.' : 'A little more flavour.'}</em>
    </h2>
    <a class="button" href={routes[lang].contact}>
      {copy[lang].reserve} <Arrow />
    </a>
  </div>
</section>
